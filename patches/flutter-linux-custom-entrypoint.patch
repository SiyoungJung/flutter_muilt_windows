+G_MODULE_EXPORT void fl_dart_project_set_dart_entrypoint(
+    FlDartProject* self, const gchar* entrypoint) {
+  g_return_if_fail(FL_IS_DART_PROJECT(self));
+  gchar* copy = g_strdup(entrypoint);
+  g_free(self->dart_entrypoint);
+  self->dart_entrypoint = copy;
+}
